# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Model Configuration
# Bare name (mobile_sam.pt) lets Ultralytics auto-download on first start.
MODEL_PATH=mobile_sam.pt
MAX_IMAGE_SIZE=1024
# Smaller SAM input on CPU (Railway). Raise to 1024 locally if needed.
SAM_IMGSZ=512
# ONNX weights are downloaded from Hugging Face on first boot.
MODEL_DIR=models
SESSION_TTL_MINUTES=10
# Benchmark: /predict reuse_embedding=false forces encode every click (see scripts/bench_sam_cache.py)

# CORS Configuration
# Set FRONTEND_URL to your Vercel URL after deploy, e.g. https://xxx.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional extra origins (comma-separated)
# CORS_ORIGINS=https://xxx.vercel.app,https://xxx-git-main.vercel.app

# Performance Configuration
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=4

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# --- Frontend (Vercel project env) ---
# VITE_API_URL=https://your-railway-service.up.railway.app